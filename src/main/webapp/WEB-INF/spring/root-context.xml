<?xml version="1.0" encoding="UTF-8"?>
<beans
	xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:util="http://www.springframework.org/schema/util"
	xmlns:task="http://www.springframework.org/schema/task"
	xmlns:context="http://www.springframework.org/schema/context"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
						http://www.springframework.org/schema/task http://www.springframework.org/schema/task/spring-task.xsd
						http://www.springframework.org/schema/util http://www.springframework.org/schema/util/spring-util.xsd
						http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">

	<context:property-placeholder
		location="classpath:config/*.properties" />

	<context:component-scan
		base-package="com.frade.service" />
	<context:component-scan
		base-package="com.frade.dao" />
	<context:component-scan
		base-package="com.frade.config" />
	<context:component-scan
		base-package="com.frade.websocket" />
	<context:component-scan
		base-package="com.frade.memcache" />

	<bean
		class="org.apache.commons.dbcp2.BasicDataSource"
		id="data_source">
		<property
			name="driverClassName"
			value="${db.driver}" />
		<property
			name="url"
			value="${db.url}" />
		<property
			name="username"
			value="${db.username}" />
		<property
			name="password"
			value="${db.password}" />
	</bean>

	<bean
		class="org.mybatis.spring.SqlSessionFactoryBean"
		id="sqlSessionFactory">
		<property
			name="dataSource"
			ref="data_source"></property>
		<property
			name="mapperLocations"
			value="/WEB-INF/mybatis/mapper/**/*_mapper.xml"></property>
		<property
			name="configLocation"
			value="/WEB-INF/mybatis/mybatis-config.xml"></property>

		<!-- 최상위 패키지인 com.frade.dto만 명시하면, 그 하위 폴더의 모든 클래스를 자동 추적합니다 -->
		<property
			name="typeAliasesPackage"
			value="com.frade.dto" />
	</bean>

	<bean
		id="sqlSessionTemplate"
		class="org.mybatis.spring.SqlSessionTemplate">
		<constructor-arg
			name="sqlSessionFactory"
			ref="sqlSessionFactory" />
	</bean>


	<!-- 스프링 내장 팩토리를 이용해 '스프링 표준 세팅이 적용된' 범용 ObjectMapper를 빈으로 등록합니다 -->
	<bean id="objectMapper"
		class="org.springframework.http.converter.json.Jackson2ObjectMapperFactoryBean">
		<!-- pom.xml에 등록한 JavaTimeModule 모듈명을 강제로 팩토리에 심어줍니다 -->
		<property name="findModulesViaServiceLoader" value="true"/>

		<!-- 👇 이 프로퍼티 설정을 추가하면 LocalDateTime이 문자열로 예쁘게 출력됩니다 -->
		<property name="featuresToDisable">
			<array>
				<util:constant
					static-field="com.fasterxml.jackson.databind.SerializationFeature.WRITE_DATES_AS_TIMESTAMPS" />
			</array>
		</property>
	</bean>


	<!-- 스케줄러 Bean 등록 -->
	<bean
		id="apiScheduler"
		class="com.frade.scheduler.ApiScheduler" />

	<!-- 스케줄러 설정 -->
	<task:scheduler
		id="mainScheduler"
		pool-size="10" />
	<task:executor
		id="mainTaskExecutor"
		pool-size="10" />
	<task:annotation-driven
		executor="mainTaskExecutor"
		scheduler="mainScheduler" />

	<!-- 다른 스케줄러와 풀을 나눠쓰지 않을 특수 스케줄러 -->
	<bean
		id="stockBatchScheduler"
		class="com.frade.scheduler.StockBatchScheduler" />
	<task:scheduler id="stockBatchSchedulerPool" pool-size="1" />
	<task:executor id="stockBatchTaskExecutor" pool-size="1" />
	
	<!-- 웹소켓 데이터 처리용 스레드 풀 -->
	<task:executor id="stockBufferTaskExecutor" 
               pool-size="1" 
               queue-capacity="10" 
               rejection-policy="CALLER_RUNS" />

</beans>