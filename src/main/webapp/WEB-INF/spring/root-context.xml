<?xml version="1.0" encoding="UTF-8"?>
<beans
	xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:util="http://www.springframework.org/schema/util"
	xmlns:task="http://www.springframework.org/schema/task"
	xmlns:context="http://www.springframework.org/schema/context"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
						http://www.springframework.org/schema/task http://www.springframework.org/schema/task/spring-task.xsd
						http://www.springframework.org/schema/util http://www.springframework.org/schema/util/spring-util.xsd
						http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">

	<context:property-placeholder
		location="classpath:config/*.properties" />

	<context:component-scan
		base-package="com.frade.service" />
	<context:component-scan
		base-package="com.frade.dao" />
	<context:component-scan
		base-package="com.frade.config" />
	<context:component-scan
		base-package="com.frade.websocket" />
	<context:component-scan
		base-package="com.frade.memcache" />

	<bean
		class="org.apache.commons.dbcp2.BasicDataSource"
		id="data_source">
		<property
			name="driverClassName"
			value="${db.driver}" />
		<property
			name="url"
			value="${db.url}" />
		<property
			name="username"
			value="${db.username}" />
		<property
			name="password"
			value="${db.password}" />
	</bean>

	<bean
		class="org.mybatis.spring.SqlSessionFactoryBean"
		id="sqlSessionFactory">
		<property
			name="dataSource"
			ref="data_source"></property>
		<property
			name="mapperLocations"
			value="/WEB-INF/mybatis/mapper/**/*_mapper.xml"></property>
		<property
			name="configLocation"
			value="/WEB-INF/mybatis/mybatis-config.xml"></property>

		<!-- 최상위 패키지인 com.frade.dto만 명시하면, 그 하위 폴더의 모든 클래스를 자동 추적합니다 -->
		<property
			name="typeAliasesPackage"
			value="com.frade.dto" />
	</bean>

	<bean
		id="sqlSessionTemplate"
		class="org.mybatis.spring.SqlSessionTemplate">
		<constructor-arg
			name="sqlSessionFactory"
			ref="sqlSessionFactory" />
	</bean>


	<!-- 스프링 내장 팩토리를 이용해 '스프링 표준 세팅이 적용된' 범용 ObjectMapper를 빈으로 등록합니다 -->
	<bean id="objectMapper"
		class="org.springframework.http.converter.json.Jackson2ObjectMapperFactoryBean">
		<!-- pom.xml에 등록한 JavaTimeModule 모듈명을 강제로 팩토리에 심어줍니다 -->
		<property name="findModulesViaServiceLoader" value="true" />

		<!-- 👇 이 프로퍼티 설정을 추가하면 LocalDateTime이 문자열로 예쁘게 출력됩니다 -->
		<property name="featuresToDisable">
			<array>
				<util:constant
					static-field="com.fasterxml.jackson.databind.SerializationFeature.WRITE_DATES_AS_TIMESTAMPS" />
			</array>
		</property>
	</bean>

	<!-- 1. 최대 SSE 소켓 물리 통로 수 2만 개 확장 -->
	<bean id="tomcatMaxConnectionsConfig"
		class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
		<property name="targetClass" value="java.lang.System" />
		<property name="targetMethod" value="setProperty" />
		<property name="arguments">
			<list>
				<value>org.apache.tomcat.util.net.MAX_CONNECTIONS</value>
				<value>20000</value>
			</list>
		</property>
	</bean>

	<!-- 2. 일꾼 스레드 개수 200개 강제 고정 -->
	<bean id="tomcatMaxThreadsConfig"
		class="org.springframework.beans.factory.config.MethodInvokingFactoryBean">
		<property name="targetClass" value="java.lang.System" />
		<property name="targetMethod" value="setProperty" />
		<property name="arguments">
			<list>
				<value>org.apache.tomcat.util.net.MAX_THREADS</value>
				<value>200</value>
			</list>
		</property>
	</bean>

	<!-- ⭕ 외부 라이브러리 일절 없이 1분 주기 통신까지 무결하게 수용하는 자바 내장 엔진 -->
	<bean id="simpleClientHttpRequestFactory"
		class="org.springframework.http.client.SimpleClientHttpRequestFactory">
		<property name="connectTimeout" value="5000" /> <!-- 연결 마진 5초 -->
		<property name="readTimeout" value="10000" />    <!-- 데이터 대기 마진 10초 -->
	</bean>

	<!-- RestTemplate 빈 등록 및 어제 완성한 표준 objectMapper 결합 -->
	<bean id="restTemplate" class="org.springframework.web.client.RestTemplate">
		<constructor-arg ref="simpleClientHttpRequestFactory" />
		<property name="messageConverters">
			<list>
				<!-- 💡 요청/응답 시 Jackson ObjectMapper를 통한 자바 객체 ↔ JSON 자동 파싱 컨버터 -->
				<bean
					class="org.springframework.http.converter.json.MappingJackson2HttpMessageConverter">
					<property name="objectMapper" ref="objectMapper" />
				</bean>
				<!-- 문자열 인코딩 깨짐 방지 -->
				<bean
					class="org.springframework.http.converter.StringHttpMessageConverter">
					<property name="supportedMediaTypes">
						<list>
							<bean class="org.springframework.http.MediaType">
								<constructor-arg value="text" />
								<constructor-arg value="plain" />
								<constructor-arg value="UTF-8" />
							</bean>
						</list>
					</property>
				</bean>
			</list>
		</property>
	</bean>


	<!-- 스케줄러 Bean 등록 -->
	<bean
		id="apiScheduler"
		class="com.frade.scheduler.ApiScheduler" />

	<!-- 스케줄러 설정 -->
	<task:scheduler
		id="mainScheduler"
		pool-size="10" />
	<task:executor
		id="mainTaskExecutor"
		pool-size="10" />
	<task:annotation-driven
		executor="mainTaskExecutor"
		scheduler="mainScheduler" />

	<!-- 다른 스케줄러와 풀을 나눠쓰지 않을 특수 스케줄러 -->
	<bean
		id="stockDataScheduler"
		class="com.frade.scheduler.StockDataScheduler" />
	<task:scheduler id="stockDataSchedulerPool" pool-size="1" />
	<task:executor id="stockDataTaskExecutor" pool-size="1" />

	<!-- 웹소켓 데이터 처리용 스레드 풀 -->
	<task:executor id="stockBufferTaskExecutor"
		pool-size="1"
		queue-capacity="10"
		rejection-policy="CALLER_RUNS" />

</beans>